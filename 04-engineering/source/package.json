{
  "name": "@pokapu/source",
  "version": "0.0.1",
  "private": true,
  "description": "Pokapu source workspace.",
  "type": "module",
  "scripts": {
    "browsers:install": "playwright install",
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @pokapu/web-e2e test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "oxfmt": "0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
